# ===========================================================================
# Medusa - plantilla de variables de entorno.
# Copia este archivo a ".env" y ajusta los valores. El ".env" real NO se
# commitea (esta en .gitignore) y vive solo en CT202.
# ===========================================================================

# ---------- Modo de operacion ----------
# paper | live   (arranca SIEMPRE en paper; live requiere superar el gate de
# validacion de 7-14 dias y activarse desde el dashboard con confirmacion).
MODE=paper

# ---------- Base de datos (Postgres) ----------
DB_USER=medusa
DB_PASSWORD=CAMBIA_ESTO_por_un_password_fuerte
DB_NAME=medusa
DB_HOST=postgres
DB_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_JSON=true

# ---------- Engine ----------
HEARTBEAT_INTERVAL=15
SCAN_INTERVAL=60

# ---------- Dashboard ----------
DASHBOARD_PORT=8080

# ---------- Market Scanner ----------
SCAN_MAX_MARKETS=40
MIN_LIQUIDITY=500
MIN_VOLUME_24H=1000

# ---------- Prediction Engine ----------
# 0.0 = SIN señal (default). El estudio de calibracion
# (research/calibration_study.py, 2026-07-16, n=1856 mercados resueltos) mostro
# que Polymarket esta bien calibrado: la reversion a la media no tiene edge y
# solo paga spread. Subir esto reactiva el baseline solo para experimentos.
REVERSION_K=0.0

# ---------- Risk Manager ----------
PAPER_STARTING_BALANCE=1000
MIN_EDGE=0.03
MAX_POSITION_USD=50
POSITION_FRACTION=0.05
MAX_EXPOSURE_PCT=0.50
MAX_OPEN_POSITIONS=8
# El edge debe superar el coste de round-trip (spread+slippage+fees) por este
# multiplo. Sin esto el bot entra en mercados de precio extremo cuyo spread
# relativo (medido: hasta 27%) se traga cualquier edge.
EDGE_COST_RATIO=1.5
# Perdida maxima DEL DIA (se reinicia al cambiar el dia UTC). No es drawdown
# total: un limite total latcheado detendria el bot para siempre.
MAX_DAILY_LOSS_PCT=0.10

# ---------- Costes de simulacion (Paper) ----------
# Polymarket ha cobrado 0 al taker historicamente. Si activa fees, subir FEE_BPS.
FEE_BPS=0
EXTRA_SLIPPAGE_BPS=10
BOOK_DEPTH_FRACTION=0.5

# ---------- Salidas ----------
TAKE_PROFIT_PCT=0.20
STOP_LOSS_PCT=0.15

# ---------- Gate de validacion Paper -> Live ----------
PAPER_VALIDATION_MIN_DAYS=7
PAPER_VALIDATION_MAX_DAYS=14
PAPER_VALIDATION_MIN_TRADES=30

# ---------- Wallet Intelligence (medusa.intelligence.wallet) ----------
# Perfilado NUMERICO de wallets publicas de Polymarket: 19 metricas (ADN),
# score relativo a la poblacion, reputacion, clusters y similitud.
# NO ES COPY TRADING: produce FEATURES, jamas ordenes. Ninguna funcion del
# paquete devuelve un lado, un tamaño ni un precio.
WALLET_INTEL_ENABLED=false
WALLET_INTEL_INTERVAL=3600
WALLET_INTEL_TIMEOUT=300
# Tamaño de la poblacion. OJO: el ADN se estandariza CONTRA ESTA POBLACION, asi
# que cambiar estos topes cambia el significado de los scores. No es solo coste.
WALLET_MAX_MARKETS=25
WALLET_HOLDERS_PER_MARKET=50
WALLET_MAX_WALLETS=200
WALLET_MAX_POSITIONS=500
WALLET_MAX_ACTIVITY=500
# Ventanas temporales: que cuenta como "reciente", semivida de la frescura y
# cubo de alpha/beta.
WALLET_RECENT_DAYS=30
WALLET_HALF_LIFE_DAYS=30
WALLET_BUCKET_DAYS=7
# Muestra minima antes de creerse una reputacion. Alineado con
# ALLOC_MIN_SAMPLES: no puede haber dos definiciones de "hay muestra".
WALLET_MIN_SAMPLES=30
# Clustering (k-means determinista) y similitud (coseno).
WALLET_CLUSTERS_K=5
WALLET_MIN_CLUSTER_WALLETS=6
WALLET_MIN_SIMILARITY=0.70
WALLET_SIMILARITY_TOP_K=5
# Mercados que enriquece el modulo del Intelligence Layer por pasada. Ademas
# hay que nombrar el modulo en INTELLIGENCE_MODULES para que corra:
#   INTELLIGENCE_MODULES=microstructure,wallet
WALLET_FEATURE_MAX_MARKETS=15
WALLET_RETENTION_DAYS=365

# ---------- Market Intelligence Graph (medusa.intelligence.mig) ----------
# Grafo de relaciones entre las entidades de Medusa (mercados, categorias,
# series de eventos, estrategias, trades, resoluciones, features, experimentos).
# SOLO PostgreSQL, sin Neo4j. NO opera, NO emite señales y NO toca el Risk
# Manager: solo lee tablas y escribe en las suyas (mig_*).
# Con false el engine no lo construye solo; el boton del Research Lab sigue
# permitiendo construirlo a mano.
MIG_ENABLED=false
# Cada cuanto se reconstruye (seg). Las relaciones que describe cambian en dias.
MIG_INTERVAL=3600
MIG_TIMEOUT=120
# Muestras minimas para que una celda (estrategia x categoria) emita veredicto.
# Debe ir alineado con ALLOC_MIN_SAMPLES: no puede haber dos definiciones de
# "hay muestra suficiente".
MIG_MIN_SAMPLES=30
MIG_MIN_OBSERVATIONS=20
# Similitud minima (Jaccard sobre las palabras de la pregunta) para unir dos
# mercados. Bajarlo hace que todo se parezca con todo y similar_to deje de
# significar nada.
MIG_MIN_SIMILARITY=0.35
# Ventana de datos por construccion (acota memoria; no falsea nada).
MIG_MAX_MARKETS=300
MIG_MAX_SIGNALS=5000
MIG_MAX_TRADES=2000
MIG_MAX_FEATURES=5000
# Poda de descubrimientos y snapshots. Nodos y aristas NO se podan.
MIG_RETENTION_DAYS=365

# ---------- Information Flow Engine (medusa.intelligence.flow) ----------
# Mide COMO SE PROPAGA la informacion dentro de un mercado: quien entra antes,
# cuanto tarda en entrar el siguiente, cuanto tarda el consenso, que hizo el
# precio despues y como resolvio el mercado.
# MIDE PROPAGACION, JAMAS CAUSALIDAD: que una wallet entre despues de otra no
# significa que la siga. NO opera, NO emite señales y solo escribe en flow_*.
# Con false el engine no lo ejecuta solo; el boton de la pagina sigue
# permitiendo lanzar una pasada a mano.
FLOW_ENABLED=false
# Cada cuanto corre una pasada (seg) y su presupuesto de tiempo.
FLOW_INTERVAL=1800
FLOW_TIMEOUT=180
# Mercados por pasada y trades que se piden de cada uno (acota las peticiones a
# la API publica y la memoria; no falsea nada).
FLOW_MAX_MARKETS=40
FLOW_TRADES_PER_MARKET=500
# Ventana de historia que se ANALIZA (sale de la BD, no de la red).
FLOW_LOOKBACK_HOURS=72
# Hueco maximo entre dos entradas para seguir en la misma cascada. Subirlo une
# rachas que no tienen nada que ver; bajarlo parte cadenas reales.
FLOW_WINDOW_SECONDS=3600
# Participantes minimos de una cascada. Con 2, cualquier par de entradas
# seguidas seria una "cascada" y la tabla se llenaria de coincidencias.
FLOW_MIN_PARTICIPANTS=3
# Distancia maxima en la cadena para emitir un eslabon (evita el O(n^2)).
FLOW_MAX_HOPS=3
# Fraccion de la cascada que define el CONSENSUS DELAY.
FLOW_CONSENSUS_FRACTION=0.5
# Vida media (seg) del speed_score: hace comparables mercados de escalas muy
# distintas (una carrera electoral y una ventana de 5 min).
FLOW_SPEED_HALF_LIFE=300
# Que se considera entrada "temprana" y "tardia" por rango normalizado.
FLOW_EARLY_FRACTION=0.33
FLOW_LATE_FRACTION=0.33
# Movimiento minimo del precio para que una cascada sin resolver puntue. Por
# debajo la observacion NO cuenta: contar empates es fabricar significancia.
FLOW_MIN_PRICE_MOVE=0.02
# Cascadas minimas para leer a una wallet como evidencia, y coincidencias
# minimas para publicar un par (lider, seguidor).
FLOW_MIN_SAMPLES=10
FLOW_MIN_PAIR_OBSERVATIONS=5
# Poda. La cinta cruda crece rapido y se poda pronto; cascadas, eslabones y
# snapshots son el conocimiento del motor y aguantan mucho mas.
FLOW_RETENTION_DAYS=365
FLOW_TRADE_RETENTION_DAYS=45

# ---------- Micro-trader "Up or Down" 5 min (medusa.updown) ----------
# Subsistema desacoplado para las ventanas cripto de 5 min de Polymarket
# (bnb-updown-5m-*). SOLO PAPER: simula el fill contra el libro real y liquida
# contra la resolucion real, pero jamas manda una orden on-chain. Ponlo a true
# para activarlo; con false el engine se comporta como si no existiera.
UPDOWN_ENABLED=true
# CSV de activos (bnb, btc, eth, sol, xrp). Cada uno usa su spot de Binance como
# proxy de direccion del stream Chainlink con el que resuelve el mercado.
UPDOWN_ASSETS=bnb
UPDOWN_TICK_INTERVAL=5
# Solo se apuesta en los ultimos N segundos de la ventana (cuando el movimiento
# ya se decanto), y no en el ultimo parpadeo.
UPDOWN_ENTRY_WINDOW_SECS=90
UPDOWN_MIN_SECS_LEFT=8
# CANDADO 1 (winrate): certeza minima del modelo en el lado favorecido.
UPDOWN_MIN_PROB=0.90
# CANDADO 2 (anti-Hermes): EV minimo por share = prob - ask. Un resultado casi
# seguro que ya cotiza a 0.99 no es negocio; exigir EV real lo filtra.
UPDOWN_MIN_EV=0.02
UPDOWN_MAX_ASK=0.95
UPDOWN_STAKE_USD=20
UPDOWN_SETTLE_TIMEOUT=300
UPDOWN_VOID_AFTER=3600

# ---- Risk manager del micro-trader Up/Down ----
# Cortafuegos del bot (ademas del kill-switch de cuenta). Sizing por bankroll:
# con STAKE_FRACTION=0 se usa el fijo UPDOWN_STAKE_USD; con p.ej. 0.02 la apuesta
# es 2% del balance, acotada a [MIN_STAKE, MAX_STAKE].
UPDOWN_STAKE_FRACTION=0
UPDOWN_MIN_STAKE=5
UPDOWN_MAX_STAKE=25
UPDOWN_MAX_OPEN=3                 # apuestas abiertas a la vez
UPDOWN_MAX_EXPOSURE_PCT=0.20      # % del balance en riesgo simultaneo
UPDOWN_MIN_BALANCE=25            # no apostar por debajo de este balance
UPDOWN_MAX_DAILY_BETS=60          # tope de apuestas por dia UTC
UPDOWN_MAX_DAILY_LOSS_PCT=0.15    # stop del dia si el PnL updown cae este % del balance de apertura
UPDOWN_MAX_CONSECUTIVE_LOSSES=4   # tras N perdidas seguidas -> cooldown
UPDOWN_COOLDOWN_SECS=900          # 15 min de pausa anti-racha

# ---------- Notificaciones (SOLO Discord) ----------
# IMPORTANTE: regenera el webhook en Discord antes de usarlo (el que se compartio
# en el chat quedo expuesto). Sin otros canales (ni Telegram/Email/Slack).
DISCORD_WEBHOOK_URL=
NOTIFY_OPPORTUNITIES=false

# ---------- Secretos LIVE (dejar VACIO hasta habilitar Live) ----------
# Nunca commitear el .env real. Estos solo se rellenan en CT202 al pasar a Live.
PRIVATE_KEY=
WALLET_ADDRESS=
POLYMARKET_API_KEY=

# ---------- Reconciliacion on-chain (solo Live) ----------
# La cadena es la verdad. Si las posiciones reales no cuadran con la BD, el
# engine se niega a operar en Live y vuelve a PAPER.
RECONCILE_INTERVAL=300
RECONCILE_SIZE_TOLERANCE=0.01
RECONCILE_MIN_SHARES=1.0

# ---------- CLOB (Live) ----------
# 0 = EOA (la clave privada es la dueña de los fondos).
# 1 = proxy email/magic, 2 = proxy de wallet de navegador (Polymarket UI).
# Con 1 o 2 hay que fijar CLOB_FUNDER a la direccion del proxy que tiene el USDC.
CLOB_SIGNATURE_TYPE=0
CLOB_FUNDER=
